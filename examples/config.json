{
  "targets": ["http://127.0.0.1:8080"],
  "wordlist": "examples/words.txt",
  "scope": {
    "allowed_hosts": ["127.0.0.1"]
  },
  "excludes": {
    "path_prefixes": ["/logout"]
  },
  "rate_limit": 20,
  "per_target_concurrency": 4,
  "max_retries": 3,
  "checkpoint": "checkpoint.json",
  "output": "results.json",
  "headers": {
    "X-Custom-Header": "value"
  },
  "auth": {
    "type": "bearer",
    "token": "replace-me"
  }
}
